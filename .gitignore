# Dependências (A pasta mais pesada, nunca deve subir)
node_modules/
.pnp
.pnp.js

# Produção (Ficheiros gerados pelo comando 'npm run build')
dist/
build/

# Logs (Ficheiros de erro temporários)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de Ambiente (Segurança: chaves de API, segredos)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor de Código (Configurações específicas do teu VS Code)
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sistema Operativo (Ficheiros inúteis que o Windows e Mac criam)
.DS_Store
Thumbs.db